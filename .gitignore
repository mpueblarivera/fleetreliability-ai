# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
ENV/
env/

# Distribution / packaging
dist/
build/
*.egg-info/

# Jupyter Notebook
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# Pytest & Coverage
.pytest_cache/
.coverage
htmlcov/

# Data files (keep directory structure via .gitkeep)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Serialized local model artifacts (track only the canonical champion artifact)
models/*.pkl
models/*.bin
models/*.joblib
!models/best_model.bin
*.pkl
*.bin
*.joblib

# Environment variables & secrets
.env
.env.*
!.env.example

# IDE / OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
